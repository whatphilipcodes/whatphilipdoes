---
import NavBar from '@/components/NavBar.astro';
import BaseHead from '../components/BaseHead.astro';
import '../styles/view-transitions.css';
interface Props {
	title?: string;
	description?: string;
	created?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title={title ?? "whatphilipdoes"}
			description={description ?? "personal portfolio website"}
		/>
	</head>
	<body class="dark:bg-mono-950 bg-mono-100">
		<NavBar/>
		<main class="@container/main view-main">
			<slot/>
		</main>
	</body>
</html>

<style>
html {
	scrollbar-width: thin;
	scrollbar-gutter: stable both-edges;
	scrollbar-color: var(--color-mono-500) transparent;
}
</style>
