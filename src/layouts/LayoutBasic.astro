---
import ObservantMenu from '@react/ObservantMenu';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import type { HeadProps } from '@/content.config';

type Props = HeadProps;
const { title, description, previewImage } = Astro.props;
---

<!doctype html>
<html
	lang="en"
	class="hide-scrollbar bg-mono-50 text-mono-950 dark:bg-mono-950 dark:text-mono-50"
>
	<BaseHead title={title ?? "whatphilipdoes"} {description} {previewImage} />
	<body class="flex min-h-lvh flex-col">
		<ObservantMenu pathname={Astro.url.pathname} client:only />
		<main class="min-h-full grow">
			<slot />
		</main>
		<Footer />
	</body>
</html>
