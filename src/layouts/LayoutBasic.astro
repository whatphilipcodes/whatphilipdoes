---
import ObservantMenu from '@react/ObservantMenu';
import BaseHead from '@comps/BaseHead.astro';
import '@/styles/view-transitions.css';

interface Props {
	title?: string;
	description?: string;
	created?: string;
}
const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en" class="hide-scrollbar">
	<head>
		<BaseHead
			title={title ?? "whatphilipdoes"}
			description={description ?? "personal portfolio website"}
		/>
	</head>
	<body class="dark:bg-mono-950 bg-mono-100">
		<ObservantMenu pathname={Astro.url.pathname} client:only="react" />
		<main class="@container/main">
			<slot />
		</main>
	</body>
</html>
