---
import ObservantMenu from '@react/ObservantMenu';
import BaseHead from '@/components/BaseHead.astro';
import Footer from '@/components/Footer.astro';
import type { HeadProps } from '@/content.config';

type Props = HeadProps;
const { title, description, previewImage } = Astro.props;
---

<!doctype html>
<html
	id="html"
	lang="en"
	class="hyphens-auto hide-scrollbar bg-mono-50 text-mono-600 dark:bg-neutral-950 dark:text-mono-400"
>
	<BaseHead title={title ?? "whatphilipdoes"} {description} {previewImage} />
	<body class="flex min-h-dvh flex-col">
		<ObservantMenu pathname={Astro.url.pathname} client:only />
		<main class="grid-main min-h-full grow py-4 md:py-8 lg:py-16">
			<slot />
		</main>
		<Footer />
	</body>
</html>

<script>
	import { $locale } from '@/store/menuStore';
	import { getElement } from '@/utils/helpers';

	const currentLocale = $locale.get();
	const doc = getElement('html');
</script>
