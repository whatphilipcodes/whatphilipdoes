---
import { MAIL } from 'astro:env/server';

const routes = [
	{ text: 'does', href: '/' },
	{ text: 'built', href: '/built/' },
	{ text: 'knows', href: '/knows/' },
];

const context = 'context';
---

<nav
	class="fixed bottom-2 md:bottom-8 left-1/2 z-50 -translate-x-1/2 text-lg flex flex-row items-center rounded-4xl border-mono-200 dark:border-mono-900 bg-mono-100/50 dark:bg-mono-950/50 backdrop-blur-md h-14 view-nav"
>
	<div class="flex h-full">
		{routes.map((route) => {
                const isActive = Astro.url.pathname === route.href;
                return (
                    <a
                        href={route.href}
                        class={`flex h-full cursor-pointer flex-row items-center justify-center gap-1 rounded-4xl px-2 transition-colors first:pl-4 last:pr-4 ${isActive 
                            ? 'text-mono-900 dark:text-mono-100'
                            : 'text-mono-400 hover:text-mono-600 dark:hover:text-mono-200'}`}
                    >
                        <span>/</span>
                        <span>{route.text}</span>
                    </a>
                );
            })}
	</div>
	<a
		id="context-btn"
		class="flex h-full items-center pr-2"
		style="overflow: hidden; white-space: nowrap;"
		href={`mailto:${MAIL}`}
	>
		<div
			class="rounded-4xl py-1 px-2 text-center border text-mono-200 border-mono-200"
		>
			{context}
		</div>
	</a>
</nav>

<script>
	import { get, type WAAPIAnimation, waapi } from 'animejs';

	const contactBtn = document.getElementById('context-btn');

	if (contactBtn) {
		// Fetch original styles using the animejs get helper
		const originalWidth = get(contactBtn, 'width', 'px');
		const originalPaddingLeft = get(contactBtn, 'paddingLeft', 'px');
		const originalPaddingRight = get(contactBtn, 'paddingRight', 'px');

		const config = {
			hideThreshold: 60,
			showThreshold: 40,
		};

		let lastScrollY = window.scrollY;
		let scrollDelta = 0;
		let isHidden = false;
		let ticking = false;
		let currentAnimation: WAAPIAnimation | null = null;

		window.addEventListener('scroll', () => {
			if (!ticking) {
				window.requestAnimationFrame(() => {
					const currentScrollY = window.scrollY;
					const diff = currentScrollY - lastScrollY;

					if (diff > 0) {
						// Scrolling down
						if (scrollDelta < 0) scrollDelta = 0;
						scrollDelta += diff;

						if (scrollDelta > config.hideThreshold && !isHidden) {
							isHidden = true;
							if (currentAnimation) currentAnimation.cancel();

							currentAnimation = waapi.animate(contactBtn, {
								width: [originalWidth, 0],
								paddingLeft: [originalPaddingLeft, 0],
								paddingRight: [originalPaddingRight, 0],
								opacity: [1, 0],
								duration: 350,
								ease: 'outQuad',
							});
						}
					} else if (diff < 0) {
						// Scrolling up
						if (scrollDelta > 0) scrollDelta = 0;
						scrollDelta += diff;

						if (Math.abs(scrollDelta) > config.showThreshold && isHidden) {
							isHidden = false;
							if (currentAnimation) currentAnimation.cancel();

							currentAnimation = waapi.animate(contactBtn, {
								width: [0, originalWidth],
								paddingLeft: [0, originalPaddingLeft],
								paddingRight: [0, originalPaddingRight],
								opacity: [0, 1],
								duration: 350,
								ease: 'outQuad',
							});
						}
					}

					lastScrollY = currentScrollY;
					ticking = false;
				});
				ticking = true;
			}
		});
	}
</script>
