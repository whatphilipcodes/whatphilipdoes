---
import { MAIL } from 'astro:env/server';

const routes = [
	{ text: 'does', href: '/' },
	{ text: 'built', href: '/built/' },
	{ text: 'knows', href: '/knows/' },
];
---

<nav class="fixed bottom-10 left-1/2 z-50 -translate-x-1/2 text-lg">
	<div class="flex h-12 flex-row items-center gap-6">
		<a
			class="hidden md:block border rounded-lg border-mono-200 dark:border-mono-900 bg-mono-100/75 dark:bg-mono-950/75 px-5 py-2 text-mono-900 dark:text-mono-100 backdrop-blur-md view-nav-logo"
			href="/"
		>
			wp
		</a>

		<div
			class="flex flex-row items-center gap-6 rounded-lg border border-mono-200 dark:border-mono-900 bg-mono-100/75 dark:bg-mono-950/75 backdrop-blur-md view-nav-routes"
		>
			{routes.map((route) => {
                const isActive = Astro.url.pathname === route.href;
                return (
                    <a
                        href={route.href}
                        class={`flex cursor-pointer flex-row gap-2 rounded-lg py-2 transition-colors first:pl-4 last:pr-4 
                        ${isActive 
                            ? 'text-mono-900 dark:text-mono-100'
                            : 'text-mono-400 hover:text-mono-600 dark:hover:text-mono-200'}`}
                    >
                        <span>/</span>
                        <span>{route.text}</span>
                    </a>
                );
            })}
		</div>

		<a
			class="hidden md:block border rounded-lg border-mono-200 dark:border-mono-900 bg-mono-100/75 dark:bg-mono-950/75 px-5 py-2 text-mono-900 dark:text-mono-100 hover:text-mono-800 dark:hover:text-mono-100 backdrop-blur-md view-nav-contact"
			href={`mailto:${MAIL}`}
		>
			contact
		</a>
	</div>
</nav>
