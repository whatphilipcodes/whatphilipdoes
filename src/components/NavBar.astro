---
import { MAIL } from 'astro:env/server';

const routes = [
	{ text: 'does', href: '/' },
	{ text: 'built', href: '/built/' },
	{ text: 'knows', href: '/knows/' },
];
---

<nav
	class="fixed bottom-2 md:bottom-8 left-1/2 z-50 -translate-x-1/2 text-lg flex flex-row items-center rounded-4xl border-mono-200 dark:border-mono-900 bg-mono-100/50 dark:bg-mono-950/50 backdrop-blur-md h-14 view-nav"
>
	<div class="flex h-full">
		{routes.map((route) => {
                const isActive = Astro.url.pathname === route.href;
                return (
                    <a
                        href={route.href}
                        class={`flex h-full px-2 first:pl-4 cursor-pointer flex-row items-center justify-center gap-1 rounded-4xl transition-colors ${isActive 
                            ? 'text-mono-900 dark:text-mono-100'
                            : 'text-mono-400 hover:text-mono-600 dark:hover:text-mono-200'}`}
                    >
                        <span>/</span>
                        <span>{route.text}</span>
                    </a>
                );
            })}
	</div>
	<a class="flex h-full items-center px-2" href="">
		<div
			class="rounded-4xl py-1 px-2 text-center border text-mono-200 border-mono-200"
		>
			contact
		</div>
	</a>
</nav>
