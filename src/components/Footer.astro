---
import { SERVER_URL_LIVE } from 'astro:env/server';
import GridMain from '@react/GridMain';
import SpacingSides from '@react/SpacingSides';

const today = new Date();

interface Props {
	className?: string;
}
const { className } = Astro.props;
---

<footer
	class={`${className} h-48 w-full items-center border-t border-mono-600`}
>
	<SpacingSides>
		<GridMain>
			<div>made in berlin</div>
			<div>&copy;</div>
			<div class="font-mono">{today.getFullYear()}</div>
			<a href={'/legal/imprint'}>imprint</a>
			<a href={'/legal/privacy'}>privacy</a>
		</GridMain>
	</SpacingSides>
</footer>
