---
const today = new Date();
---

<div class="grid-main border-t border-mono-600">
	<footer
		class="flex flex-row flex-wrap gap-4 py-4 md:py-8 justify-center h-32 md:h-42 w-full text-mono-400 dark:text-mono-600"
	>
		<div class="flex flex-row gap-4 h-fit">
			<span>whatphilipdoes</span>
			<span>&copy;</span>
			<span>{today.getFullYear()}</span>
		</div>
		<div class="flex flex-row gap-4 h-fit">
			<a
				class="text-mono-400 dark:text-mono-600 hover:text-mono-950 dark:hover:text-mono-50 transition-colors duration-300"
				href={'/legal/imprint'}
				>imprint</a
			>
			<a
				class="text-mono-400 dark:text-mono-600 hover:text-mono-950 dark:hover:text-mono-50 transition-colors duration-300"
				href={'/legal/privacy'}
				>privacy</a
			>
		</div>
	</footer>
</div>
