---
import type { HTMLAttributes } from 'astro/types';

type Props = HTMLAttributes<'a'>;

const { href, ...props } = Astro.props;
---

<a
	class="inline-flex items-baseline underline underline-offset-3 decoration-transparent text-mono-950 hover:decoration-mono-950 dark:text-mono-50 dark:hover:decoration-mono-50 duration-300 transition-colors"
	href={href}
	{...props}
>
	<span><slot /></span>
	<svg
		xmlns="http://www.w3.org/2000/svg"
		width="18"
		height="18"
		viewBox="0 0 24 24"
		fill="none"
		stroke="currentColor"
		stroke-width="2"
		stroke-linecap="round"
		stroke-linejoin="round"
		class="shrink-0 self-center"
	>
		<title>link icon</title>
		<path d="M7 7h10v10" />
		<path d="M7 17 17 7" />
	</svg>
</a>
