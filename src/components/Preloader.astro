---
const statusArray = [
	{ txt: 'starts', cls: '' },
	{ txt: 'reads', cls: '' },
	{ txt: 'solves', cls: '' },
	{ txt: 'thinks', cls: 'hidden md:block' },
	{ txt: 'learns', cls: 'hidden md:block' },
	{ txt: 'creates', cls: '' },
	{ txt: 'enjoys', cls: 'hidden md:block' },
	{ txt: 'plans', cls: '' },
	{ txt: 'designs', cls: '' },
	{ txt: 'leads', cls: '' },
	{ txt: 'gains', cls: 'hidden md:block' },
	{ txt: 'makes', cls: '' },
	{ txt: 'builds', cls: '' },
	{ txt: 'codes', cls: '' },
	{ txt: 'fixes', cls: 'hidden md:block' },
	{ txt: 'develops', cls: 'hidden md:block' },
	{ txt: 'ships', cls: '' },
];
---

<div data-info="preloader-page-wrapper" class="h-dvh overflow-clip">
	<div
		data-info="preloader-element"
		class="flex justify-center h-dvh text-mono-50 bg-mono-950 text-lg p-10 relative"
	>
		<div data-info="preloader-screen-area" class="w-full h-full flex flex-row">
			<div
				data-info="preloader-progress-area"
				class="flex flex-col w-full h-full z-1"
			>
				<div
					data-info="preloader-keyword-container"
					class="@container-size flex flex-col place-content-between relative w-full h-full"
				>
					<div
						id="preloader-keyword-view"
						data-info="preloader-keyword-view"
						class="flex flex-col w-full h-lh overflow-clip absolute"
					>
						<div
							id="preloader-keyword-col"
							data-info="preloader-keyword-col"
							class="flex flex-col place-content-between shrink-0 grow-0 h-[80cqh]"
						>
							{statusArray.map((status) => <div class={status.cls}>{status.txt}</div>)}
						</div>
					</div>
				</div>
				<div class="preloader-page-name text-mono-500 flex">
					<span class="flex items-end">w</span>
					<span
						class="wp-segment-wrapper flex items-end overflow-hidden will-change-[width]"
					>
						<span class="wp-segment-inner block w-max whitespace-pre"
							>hat&nbsp;
						</span>
					</span>
					<span class="flex items-end">p</span>
					<span
						class="wp-segment-wrapper flex items-end overflow-hidden will-change-[width]"
					>
						<span class="wp-segment-inner block w-max">hilip</span>
					</span>
				</div>
			</div>
			<div
				data-info="preloader-progress-bar-container"
				class="w-px h-full overflow-hidden rounded-md z-1"
			>
				<div
					id="preloader-progress-bar"
					data-info="preloader-progress-bar"
					class="bg-mono-50 w-full h-lh"
				></div>
			</div>
		</div>
	</div>
	<slot />
</div>

<script>
	/*
							    WHY IS THIS NOT A REACT COMPONENT?
							    Using the setupPreloading.ts util we are tracking manually declared asset files that need to be loaded in order to display the landing page.
							    Since this process starts before React is even running on the client device, we need JS that executes as quickly as possible. With this script tag we start to run as early is possible.
							    */
	import { animate } from 'motion';
	import { getElement } from '@/utils/helpers';
	import { setupPreloading } from '@/utils/setupPreloading';

	let completedLoad = false;

	const progressBar = getElement('preloader-progress-bar') as HTMLElement;
	const keywordView = getElement('preloader-keyword-view') as HTMLElement;
	const keywordCol = getElement('preloader-keyword-col') as HTMLElement;

	const keywordEls = Array.from(keywordCol.children) as HTMLElement[];
	const containerRect = keywordCol.getBoundingClientRect();
	const containerHeight = containerRect.height;

	const positions = keywordEls
		.filter((keyword) => keyword.offsetHeight > 0)
		.map((keyword) => {
			const itemRect = keyword.getBoundingClientRect();
			const relativeTop = itemRect.top - containerRect.top;
			return (relativeTop / containerHeight) * 100;
		});
	positions.push(100);

	const getPosition = (p: number) => {
		return positions[Math.round(p * (positions.length - 1))];
	};

	const easeConfig = { type: 'spring' as const, bounce: 0, duration: 0.8 };

	// wp
	const animateMergeWP = () => {
		animate([
			[progressBar, { y: '100%' }, { at: 0, ...easeConfig }],
			['.wp-segment-wrapper', { width: [null, 0] }, { at: 0, ...easeConfig }],
			['.wp-segment-inner', { x: ['0%', '100%'] }, { at: 0, ...easeConfig }],
			['.preloader-page-name', { x: '15rem' }, { at: 0, ...easeConfig }],
		]);
	};

	// progress
	const onProgress = (p: number) => {
		const progressEase = { type: 'spring' as const, bounce: 0, duration: 2 };

		const currentPos = getPosition(p);
		const keywordYOffset = -(currentPos * 0.8);

		animate(progressBar, { height: `${currentPos}%` }, progressEase);

		animate(keywordView, { y: `${currentPos}cqh` }, progressEase);

		animate(
			keywordCol,
			{ y: `${keywordYOffset}cqh` },
			{
				...progressEase,
				onComplete: () => {
					if (completedLoad) animateMergeWP();
				},
			},
		);
	};

	const onComplete = () => {
		completedLoad = true;
	};

	setupPreloading(onProgress, onComplete, 'data-preloader', true);
</script>
