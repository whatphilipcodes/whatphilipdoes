---

<div class="@container/preloader h-dvh overflow-clip">
    <div
        id="preloader-content"
        class="flex justify-center h-dvh text-mono-50 bg-mono-950 text-2xl p-10"
    >
        <div
            id="preloader-frame"
            class="w-full h-full flex flex-col place-content-between"
        >
            <div class="">what philip</div>
            <div
                id="preloader-progress"
                class="flex w-full place-content-between"
            >
                <div id="preloader-status" class="font-bold">starts</div>
                <div
                    id="preloader-bar"
                    class="bg-mono-50 h-full w-0.5 rounded-md"
                >
                </div>
            </div>
        </div>
    </div>
    <slot />
</div>

<script>
    import { splitText, createTimer, utils } from "animejs";
    import { usePreloading } from "@/utils/usePreloading";

    const statusArray = [
        "starts",
        "sees",
        "creates",
        "enjoys",
        "gaines",
        "makes",
        "trains",
        "codes",
        "does",
    ];

    const progressEl = document.getElementById("preloader-progress")!;
    const statusEl = document.getElementById("preloader-status")!;
    const split = splitText(statusEl, { chars: true });

    let factor = 0.035;
    let progress = 0;

    let dampIndex = 0;
    let activeIndex = 0;
    const maxIndex = statusArray.length - 1;

    const dampedLoop = createTimer({
        onUpdate: (clock) => {
            if (clock.deltaTime < 0) return;
            if (activeIndex >= maxIndex) dampedLoop.cancel();

            dampIndex = utils.damp(
                dampIndex,
                Math.round(utils.mapRange(progress, 0, 1, 0, maxIndex)),
                clock.deltaTime,
                factor,
            );
            activeIndex = Math.round(dampIndex);

            const currentHeight = utils.get(progressEl, "height", false);
            utils.set(progressEl, {
                height:
                    Math.max(
                        currentHeight,
                        utils.damp(
                            currentHeight,
                            progress * 100,
                            clock.deltaTime,
                            factor,
                        ),
                    ) + "%",
            });

            split.html = statusArray[activeIndex];
            split.refresh();
        },
    });

    const onProgress = (p: number) => {
        progress = p;
        console.log("progress", progress);
    };

    const onComplete = () => {
        console.log("on complete");
    };
    usePreloading(onProgress, onComplete, "data-preloader");
</script>
