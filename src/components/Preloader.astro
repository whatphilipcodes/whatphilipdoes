---
const statusArray = [
	'starts',
	'sees',
	'reads',
	'solves',
	'thinks',
	'learns',
	'creates',
	'enjoys',
	'plans',
	'designs',
	'leads',
	'gains',
	'makes',
	'builds',
	'codes',
	'trains',
	'fixes',
	'develops',
	'ships',
	'does',
];
---

<div data-info="preloader-page-wrapper" class="h-dvh overflow-clip">
	<div
		data-info="preloader-element"
		class="flex justify-center h-dvh text-mono-50 bg-mono-950 text-xl p-10"
	>
		<div data-info="preloader-screen-area" class="w-full h-full flex flex-col">
			<div data-info="preloader-page-logo" class="text-mono-500">
				what philip
			</div>
			<div
				data-info="preloader-progress-area"
				class="flex flex-row w-full h-full"
			>
				<div
					data-info="preloader-keyword-container"
					class="@container-[size] flex flex-col place-content-between relative w-full h-full"
				>
					<div
						id="preloader-keyword-view"
						data-info="preloader-keyword-view"
						class="flex flex-col-reverse w-full h-lh overflow-clip absolute bottom-0"
					>
						<div
							id="preloader-keyword-col"
							data-info="preloader-keyword-col"
							class="flex flex-col place-content-between shrink-0 grow-0 h-[80cqh]"
						>
							{statusArray.reverse().map((status) => <div>{status}</div>)}
						</div>
					</div>
				</div>
				<div
					id="preloader-progress-bar"
					data-info="preloader-progress-bar"
					class="bg-mono-50 w-px h-0 rounded-md"
				></div>
			</div>
		</div>
	</div>
	<slot/>
</div>

<script>
import { createTimer, utils } from 'animejs';
import { getElement } from '@/utils/getElement';
import { setupPreloading } from '@/utils/setupPreloading';

const progressBar = getElement('preloader-progress-bar');
const keywordView = getElement('preloader-keyword-view');
const keywordCol = getElement('preloader-keyword-col');

const factor = 0.01;
let progress = 0;

const dampedLoop = createTimer({
	onUpdate: (clock) => {
		if (clock.deltaTime < 0) return;
		const heightBar = utils.get(progressBar, 'height', false);
		const translateKView = utils.get(keywordView, 'y', 'cqh');
		const translateKCol = utils.get(keywordCol, 'y', 'cqh');
		utils.set(progressBar, {
			height: `${utils.damp(heightBar, progress * 100, clock.deltaTime, factor)}%`,
		});
		utils.set(keywordView, {
			y: `${utils.damp(parseFloat(translateKView), -progress * 100, clock.deltaTime, factor)}cqh`,
		});
		utils.set(keywordCol, {
			y: `${utils.damp(parseFloat(translateKCol), progress * 80, clock.deltaTime, factor)}cqh`,
		});
	},
});
const onProgress = (p: number) => {
	progress = p;
};

const onComplete = () => {
	console.log('on complete');
};

setupPreloading(onProgress, onComplete, 'data-preloader');
</script>
