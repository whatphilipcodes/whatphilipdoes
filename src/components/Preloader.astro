---
const statusArray = [
	{ txt: 'starts', cls: '' },
	{ txt: 'reads', cls: '' },
	{ txt: 'solves', cls: '' },
	{ txt: 'thinks', cls: 'hidden md:block' },
	{ txt: 'learns', cls: 'hidden md:block' },
	{ txt: 'creates', cls: '' },
	{ txt: 'enjoys', cls: 'hidden md:block' },
	{ txt: 'plans', cls: '' },
	{ txt: 'designs', cls: '' },
	{ txt: 'leads', cls: '' },
	{ txt: 'gains', cls: 'hidden md:block' },
	{ txt: 'makes', cls: '' },
	{ txt: 'builds', cls: '' },
	{ txt: 'codes', cls: '' },
	{ txt: 'fixes', cls: 'hidden md:block' },
	{ txt: 'develops', cls: 'hidden md:block' },
	{ txt: 'ships', cls: '' },
	// { txt: 'does', cls: '' }, -> this should be the end state
];
---

<div data-info="preloader-page-wrapper" class="h-dvh overflow-clip">
	<div
		data-info="preloader-element"
		class="flex justify-center h-dvh text-mono-50 bg-mono-950 text-xl p-10"
	>
		<div data-info="preloader-screen-area" class="w-full h-full flex flex-row">
			<div
				data-info="preloader-progress-area"
				class="flex flex-col w-full h-full"
			>
				<div
					data-info="preloader-keyword-container"
					class="@container-[size] flex flex-col place-content-between relative w-full h-full"
				>
					<div
						id="preloader-keyword-view"
						data-info="preloader-keyword-view"
						class="flex flex-col w-full h-lh overflow-clip absolute"
					>
						<div
							id="preloader-keyword-col"
							data-info="preloader-keyword-col"
							class="flex flex-col place-content-between shrink-0 grow-0 h-[80cqh]"
						>
							{statusArray.map((status) => <div class={status.cls}>{status.txt}</div>)}
						</div>
					</div>
				</div>
				<div data-info="preloader-page-name" class="text-mono-500 flex">
					<div class="flex items-end">w</div>
					<div
						class="wp-segment-wrapper flex items-end overflow-hidden will-change-[width]"
					>
						<div class="wp-segment-inner block w-max whitespace-pre">hat </div>
					</div>

					<div class="flex items-end">p</div>
					<div
						class="wp-segment-wrapper flex items-end overflow-hidden will-change-[width]"
					>
						<div class="wp-segment-inner block w-max">hilip</div>
					</div>
				</div>
			</div>
			<div
				data-info="preloader-progress-bar-container"
				class="w-px h-full overflow-hidden rounded-md"
			>
				<div
					id="preloader-progress-bar"
					data-info="preloader-progress-bar"
					class="bg-mono-50 w-full h-0"
				></div>
			</div>
		</div>
	</div>
	<slot/>
</div>

<script>
import { waapi, spring, createTimeline, get } from 'animejs';
import { getElement } from '@/utils/getElement';
import { setupPreloading } from '@/utils/setupPreloading';

let completedLoad = false;

const progressBar = getElement('preloader-progress-bar');
const keywordView = getElement('preloader-keyword-view');
const keywordCol = getElement('preloader-keyword-col');

const keywordEls = Array.from(keywordCol.children) as HTMLElement[];
const containerRect = keywordCol.getBoundingClientRect();
const containerHeight = containerRect.height;

const positions = keywordEls
	.filter((keyword) => keyword.offsetHeight > 0)
	.map((keyword) => {
		const itemRect = keyword.getBoundingClientRect();
		const relativeTop = itemRect.top - containerRect.top;
		return (relativeTop / containerHeight) * 100;
	});
positions.push(100);

const getPosition = (p: number) => {
	return positions[Math.round(p * (positions.length - 1))];
};

const duration = 2000;
const ease = spring({ bounce: 0, duration: 800 });

// wp
const animateMergeWP = () => {
	const mergeDuration = 800;
	const tl = createTimeline();

	waapi.animate(progressBar, {
		y: '100%',
		ease: ease,
		duration: mergeDuration,
	});

	const wrapperAnim = waapi.animate('.wp-segment-wrapper', {
		width: [(el) => get(el, 'width', 'px'), 0],
		duration: mergeDuration,
		ease: ease,
		autoplay: false,
	});

	const innerAnim = waapi.animate('.wp-segment-inner', {
		x: ['0%', '-100%'],
		duration: mergeDuration,
		ease: ease,
		autoplay: false,
	});

	tl.sync(wrapperAnim, 0).sync(innerAnim, 0);
};

const onProgress = (p: number) => {
	waapi.animate(progressBar, {
		height: `${getPosition(p)}%`,
		ease: ease,
		duration: duration,
	});
	waapi.animate(keywordView, {
		y: `${getPosition(p)}cqh`,
		ease: ease,
		duration: duration,
	});
	waapi.animate(keywordCol, {
		y: `${-getPosition(p) * 0.8}cqh`,
		ease: ease,
		duration: duration,
		onComplete: () => {
			if (completedLoad) animateMergeWP();
		},
	});
};

const onComplete = () => {
	completedLoad = true;
};
setupPreloading(onProgress, onComplete, 'data-preloader');
</script>
