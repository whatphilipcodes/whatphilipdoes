---

<div
    id="preloader"
    class="fixed flex inset-0 z-50 items-center justify-center bg-black"
>
    <div class="w-64">
        <div class="h-1 w-full bg-gray-800 rounded-full overflow-hidden">
            <div
                id="progress-bar"
                class="h-full bg-white transition-all duration-300 ease-out"
                style="width: 0%"
            >
            </div>
        </div>
        <div
            id="progress-text"
            class="mt-4 text-center text-white text-sm font-mono"
        >
            0%
        </div>
    </div>
</div>

<script>
    import { usePreloading } from "@/utils/usePreloading";

    const preloader = document.getElementById("preloader");
    const progressBar = document.getElementById("progress-bar");
    const progressText = document.getElementById("progress-text");

    const onProgress = (progress: number) => {
        const percentage = Math.round(progress * 100);
        if (progressBar) {
            progressBar.style.width = `${percentage}%`;
        }
        if (progressText) {
            progressText.textContent = `${percentage}%`;
        }
        console.log("loading: ", percentage + "%");
    };
    const onComplete = () => {
        console.log("on complete");
        if (preloader) {
            setTimeout(() => {
                preloader.style.opacity = "0";
                preloader.style.transition = "opacity 0.8s ease-out";
                setTimeout(() => {
                    preloader.style.display = "none";
                }, 800);
            }, 400);
        }
    };
    usePreloading(onProgress, onComplete);
</script>
