---
import { Image } from 'astro:assets';
import testImage from '@/assets/inter/exterior/front.jpg';
import LayoutBasic from '@/layouts/LayoutBasic.astro';
---

<LayoutBasic>
	<h1 class="text-4xl text-mono-200">built page</h1>
	<Image
		data-preloader
		src="https://images.unsplash.com/photo-1762564783143-777905df5c85?q=80&w=1286&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
		alt="A bird."
		width="800"
		height="1200"
		class="w-full"
	/>
	<Image
		data-preloader
		src="https://images.unsplash.com/photo-1762912302731-508b4580735f?q=80&w=1287&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D"
		alt="A bird."
		width="800"
		height="1200"
		class="w-full"
	/>
	<div class="flex flex-row w-full justify-center my-8">
		<a
			href="/"
			class="flex rounded-2xl bg-mono-700 px-4 py-2 w-48 items-center justify-center text-white"
		>
			Test
		</a>
	</div>
	<Image
		data-preloader
		src={testImage}
		alt="A bird."
		width="1200"
		height="900"
		class="w-full"
	/>
</LayoutBasic>
