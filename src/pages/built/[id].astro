---
import { render } from 'astro:content';
import ContentStyled from '@/components/markdown/ContentStyled.astro';
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import { getBuilt } from '@/utils/content';

export async function getStaticPaths() {
	const built = await getBuilt();
	return built.map((item) => ({
		params: { id: item.id },
		props: { item },
	}));
}
const { item } = Astro.props;
const { Content } = await render(item);
---

<LayoutBasic {...item.data}>
	<ContentStyled {Content} />
</LayoutBasic>
