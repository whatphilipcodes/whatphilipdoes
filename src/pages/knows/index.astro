---
import { getEntry, render } from 'astro:content';
import ContentStyled from '@/components/markdown/ContentStyled.astro';
import LayoutBasic from '@/layouts/LayoutBasic.astro';

const page = await getEntry('nav', 'knows');
if (!page)
	throw new Error(
		'The requested .mdx files appears to be missing in the content collection',
	);
const { Content } = await render(page);
---

<LayoutBasic {...page.data}>
	<ContentStyled {Content} />
</LayoutBasic>
