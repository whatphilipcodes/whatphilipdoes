---
import { getCollection, render } from 'astro:content';
import LayoutBasic from '../../layouts/LayoutBasic.astro';

export async function getStaticPaths() {
	const legal = await getCollection('legal', ({ data }) => {
		return data.draft === false;
	});
	return legal.map((document) => ({
		params: { doc: document.id },
		props: { document },
	}));
}

const { document } = Astro.props;
const { Content } = await render(document);
---

<LayoutBasic>
	<Content />
</LayoutBasic>
