---
import { render } from 'astro:content';
import LayoutBasic from '@/layouts/LayoutBasic.astro';
import { getLegal } from '@/utils/content';

export async function getStaticPaths() {
	const legal = await getLegal();
	return legal.map((document) => ({
		params: { doc: document.id },
		props: { document },
	}));
}

const { document } = Astro.props;
const { Content } = await render(document);
---

<LayoutBasic {...document.data}>
	<Content />
</LayoutBasic>
