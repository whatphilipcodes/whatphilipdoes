---
import { getEntry, render } from 'astro:content';
import LayoutBasic from '@/layouts/LayoutBasic.astro';

const page = await getEntry('nav', 'does');
if (!page)
	throw new Error(
		'The requested .mdx files appears to be missing in the content collection',
	);
const { Content } = await render(page);
---

<LayoutBasic {...page.data}>
	<Content />
</LayoutBasic>
