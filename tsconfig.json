{
	"extends": "astro/tsconfigs/strict",
	"include": [".astro/types.d.ts", "**/*"],
	"exclude": ["dist"],
	"compilerOptions": {
		"jsx": "react-jsx",
		"jsxImportSource": "react",
		"baseUrl": ".",
		"paths": {
			"@content/*": ["content/*"],
			"@/*": ["src/*"],
			"@assets/*": ["src/assets/*"],
			"@react/*": ["src/components/react/*"],
			"@mdx/*": ["src/components/react/mdx/*"]
		}
	}
}
